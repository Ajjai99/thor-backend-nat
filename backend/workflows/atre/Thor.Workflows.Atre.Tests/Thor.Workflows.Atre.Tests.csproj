    <RootNamespace>Thor.Workflows.Atre.Tests</RootNamespace>
    <AssemblyName>Thor.Workflows.Atre.Tests</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
