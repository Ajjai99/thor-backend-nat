# Port the gRPC server binds to. Matches infra's container_port for the
# intelligence-engine ECS service (infra/envs/*/terragrunt.hcl).
GRPC_PORT=8443

# When both are set, the server serves TLS using these files (infra bakes
# them into the image at these exact paths via the Dockerfile's openssl
# step, see infra/src/modules/ecs/services.tf's per-service env vars for
# "intelligence-engine"). Leave unset for local dev (plaintext).
TLS_CERT_PATH=
TLS_CERT_KEY_PATH=

# "fake" (default) uses LangChain's FakeListChatModel — no AWS credentials
# needed. "bedrock" switches to langchain-aws ChatBedrock; only usable once
# the Bedrock VPC PrivateLink endpoint exists (ADR §13, open question O-9).
LLM_PROVIDER=fake
