# Intelligence Engine gRPC address. Plaintext for local dev (matches the Python
# service's insecure-mode default); https://intelligence-engine:8443 (ECS Service
# Connect DNS) in deployed environments.
THOR_INTELLIGENCE_ENGINE_GRPC_ADDRESS=http://localhost:8443

# Neptune (graph) for the read-only /accounts/{id} and /groups/{id} relationship routes.
# Local dev: a TinkerPop gremlin-server (docker run -p 8182:8182 tinkerpop/gremlin-server:3.7.3)
# with SSL off; deployed environments get the cluster endpoint from Terraform.
THOR_NEPTUNE_ENDPOINT=localhost
THOR_NEPTUNE_PORT=8182
THOR_NEPTUNE_ENABLESSL=false
THOR_AWS_REGION=us-east-1
# Tenant login-page logo uploads (TenantBrandingService). Any name works locally until a logo route is called.
THOR_TENANT_ASSETS_BUCKET=thor-dev-tenant-assets-local
