# Master DB auth is RDS IAM (no password): the app mints a short-lived token as
# THOR_MASTERDB_USER. THOR_MASTERDB_HOST is the IAM RDS Proxy endpoint.
THOR_MASTERDB_HOST=localhost
THOR_MASTERDB_DATABASE=thormaster
THOR_MASTERDB_USER=thor_app
THOR_MASTERDB_REGION=us-east-1
THOR_MASTERDB_PORT=5432

# Used by TenantDbContextDesignTimeFactory (dotnet ef migrations for Thor.DataLayer)
THOR_DATALAYER_HOST=localhost
THOR_DATALAYER_DATABASE=tenantone
THOR_DATALAYER_USER=thoruser
THOR_DATALAYER_PORT=5432

# S3 bucket name for storing uploaded files
THOR_UPLOADS_BUCKET=thor-uploads-dev

# RS256 public key for validating connector tokens minted by Thor.Api's registration flow
# (ADR §5.2/§8) — must be the public half of THOR_TASKAPI_JWT_PRIVATE_KEY in Thor.Api's env.
