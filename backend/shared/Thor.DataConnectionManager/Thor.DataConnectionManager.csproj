<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Thor.DataConnectionManager</RootNamespace>
    <AssemblyName>Thor.DataConnectionManager</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Thor.DataConnectionManager</PackageId>
    <Version>0.1.0</Version>
    <Description>Resolves, opens, validates, and caches per-tenant database connections against the Master metadata DB, authenticating through the tenant RDS Proxy with short-lived RDS IAM tokens (see ADR §6.2/§6.3).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Thor.DataLayer\Thor.DataLayer.csproj" />
    <ProjectReference Include="..\Thor.Core\Thor.Core.csproj" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

</Project>
