          <stringProp name="parameters"></stringProp>
          <stringProp name="script">
import org.apache.http.client.methods.HttpPut
import org.apache.http.entity.FileEntity
import org.apache.http.impl.client.CloseableHttpClient
import org.apache.http.impl.client.HttpClients
import java.io.File

def uploadUrl = vars.get("upload_url")
def zipFile   = new File(vars.get("current_zip_path"))

if (!uploadUrl || uploadUrl == "URL_NOT_FOUND") {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage("uploadUrl not found — skipping S3 PUT")
    return
}
if (!zipFile.exists()) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage("ZIP not found: ${zipFile.path}")
    return
}

CloseableHttpClient client = vars.getObject("http_client")
if (client == null) {
    client = HttpClients.createDefault()
    vars.putObject("http_client", client)
}

def put = new HttpPut(uploadUrl)
put.setEntity(new FileEntity(zipFile, org.apache.http.entity.ContentType.create("application/zip")))
put.setHeader("Content-Type", "application/zip")

def response = client.execute(put)
def status = response.getStatusLine().getStatusCode()
SampleResult.setResponseCode(String.valueOf(status))
SampleResult.setSuccessful(status == 200)
SampleResult.setResponseMessage("S3 PUT ${status} | ${zipFile.name} | ${zipFile.length()}b")
org.apache.http.util.EntityUtils.consume(response.getEntity())
          </stringProp>
