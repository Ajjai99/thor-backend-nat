            <stringProp name="parameters"></stringProp>
            <stringProp name="script">
def idx    = new Random().nextInt(10) + 1
def padded = String.format("%02d", idx)
vars.put("current_task_id",   vars.get("AD_task_${idx}"))
vars.put("current_source_id", vars.get("AD_source_id"))
vars.put("current_zip_path",  "${ZIP_POOL_PATH}/AD/task_${padded}.zip")
            </stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="Upload API Headers" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">x-thor-actor-id</stringProp>
                <stringProp name="Header.value">${actor_id}</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Authorization</stringProp>
                <stringProp name="Header.value">Bearer ${access_token}</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <!-- Extract uploadUrl directly — no URL parsing needed -->
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract AD uploadUrl" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">
import groovy.json.JsonSlurper
def body = prev.getResponseDataAsString()
try {
    def json = new JsonSlurper().parseText(body)
    vars.put("upload_url", json.uploadUrl ?: "URL_NOT_FOUND")
} catch (Exception e) {
    vars.put("upload_url", "URL_NOT_FOUND")
    log.error("AD uploadUrl parse error: ${e.message} | body: ${body?.take(300)}")
}
            </stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>

        <!-- S3 PUT: use uploadUrl directly, thread-local HttpClient (created once per thread) -->
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="AD - S3 PUT Upload" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">
import org.apache.http.client.methods.HttpPut
import org.apache.http.entity.FileEntity
import org.apache.http.impl.client.CloseableHttpClient
import org.apache.http.impl.client.HttpClients
import java.io.File

def uploadUrl = vars.get("upload_url")
def zipFile   = new File(vars.get("current_zip_path"))

if (!uploadUrl || uploadUrl == "URL_NOT_FOUND") {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage("uploadUrl not found — skipping S3 PUT")
    return
}
if (!zipFile.exists()) {
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage("ZIP not found: ${zipFile.path}")
    return
}

// Reuse the thread-local HttpClient — created once, shared across all iterations for this thread
CloseableHttpClient client = vars.getObject("http_client")
if (client == null) {
    client = HttpClients.createDefault()
    vars.putObject("http_client", client)
}

def put = new HttpPut(uploadUrl)
put.setEntity(new FileEntity(zipFile, org.apache.http.entity.ContentType.create("application/zip")))
put.setHeader("Content-Type", "application/zip")

def response = client.execute(put)
def status = response.getStatusLine().getStatusCode()
SampleResult.setResponseCode(String.valueOf(status))
SampleResult.setSuccessful(status == 200)
SampleResult.setResponseMessage("S3 PUT ${status} | ${zipFile.name} | ${zipFile.length()}b")
org.apache.http.util.EntityUtils.consume(response.getEntity())
          </stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>

